	(text "Decoupling for all power pins\n"
		(exclude_from_sim no)
		(at 82.804 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7ea63e9f-70bd-4fd1-b9b7-3039ea2ba66c")
	)
	(text "TMS	PA13	Test Mode Select (TMS) - controls the state machine of JTAG\nTCK	PA14	Test Clock (TCK) - provides the clock for the JTAG interface\nTDI	PA15	Test Data In (TDI) - data input to the STM32 from the JTAG programmer\nTDO	PB3	Test Data Out (TDO) - data output from the STM32 to the JTAG programmer\nRESET_ PB4 nRESET - optional system reset pin for resetting the STM32 during programming/debugging\nVref	3.3V supply from the STM32H7 (VDD)\nGND	Digital ground (GND) of the STM32H7\nGNDDetect	Same as GND (Digital ground)\n"
		(exclude_from_sim no)
		(at 167.132 133.096 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a46644ea-7545-4fe1-9d92-b69fd4ea5ec2")
	)
	(text "(c^2)/(2c) + 3 = 15pF\n-> c = 24pF"
		(exclude_from_sim no)
		(at 61.595 100.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e0dd00fd-7007-4096-b05c-fe2c8305ed08")
	)
	(text "Check for correct crystal\nand load caps"
		(exclude_from_sim no)
		(at 52.832 84.836 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e544237f-8466-4423-a08f-f276e153581a")
	)
	(text "Make sure the pin numbering on your TC2050 footprint matches \nthe pinout diagram you're working from, as these connectors can \nhave different pin numbering schemes depending \non the manufacturer and variant."
